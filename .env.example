# Copy to .env for local development: `cp .env.example .env`
# On Vercel, set these as Project Environment Variables instead (see docs/DEPLOY.md).
# Every VITE_* variable is read at BUILD time and inlined into the static bundle —
# changing one requires a rebuild/redeploy, not just a restart.

# Base URL of the ATMs backend API, no trailing slash.
#   Local dev:   http://localhost:8080
#   Production:  https://your-atms-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Application display name shown in the UI.
VITE_APP_NAME=CampusCheck

# Institution UUID used by the student claim / signup flow.
VITE_INSTITUTION_ID=10000000-0000-4000-8000-000000000001

# Use the in-browser mock API instead of a real backend.
# Keep this "false" in production. (Mocks only activate in dev/test builds anyway.)
VITE_USE_MOCKS=false

# Local-only: path the `pnpm sync:api` script copies the backend OpenAPI spec from.
# Not used by the app, the build, or Render.
API_SPEC_PATH="../ATMs/api/openapi.yaml"
